# ==============================================================================
# Nyaya Legal RAG — Production Environment Configuration Template
# Target: Railway (Backend API & Background Worker) + Vercel (Frontend)
#
# INSTRUCTIONS:
# Copy this file to your deployment environment variables manager (e.g. Railway Dashboard)
# or set each variable in your production secrets store.
# DO NOT commit production secrets or populated .env files to source control.
# ==============================================================================

# Application Environment & Security Mode
ENVIRONMENT=production
AUTH_MODE=prod
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
JWT_ALGORITHM=HS256

# Managed Qdrant Cloud Configuration
# (e.g. https://xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333)
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io:6333
QDRANT_COLLECTION=nyaya_legal_corpus
QDRANT_USER_COLLECTION=nyaya_user_documents
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Managed Redis Configuration (Queue & Caching)
# (e.g. Upstash Redis, Redis Cloud, or Railway Managed Redis)
REDIS_URL=rediss://default:your_redis_password@your-redis-host.com:6379/0
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379

# Statutory Document Path
# Points to pre-extracted/mounted statutory bare act PDF if available in container
PDF_PATH=BNS bare act 2023.pdf

# Hosted LLM API Provider Configuration
# Supported providers: "openai", "groq", "ollama", "custom"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_hosted_llm_api_key_here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_CHARS=8000

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment domain)
CORS_ORIGINS=https://nyaya-legal-rag.vercel.app

# Rate Limiting & Abuse Prevention
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_LIMIT=10
RATE_LIMIT_TIME_WINDOW_SECONDS=60
