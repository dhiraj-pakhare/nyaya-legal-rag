# Embedding Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_DEVICE=cpu

# Cross-Encoder Reranker Configuration
RERANKER_MODEL_NAME=cross-encoder/ms-marco-TinyBERT-L-2-v2
RERANKER_CANDIDATE_K=10
RERANKER_TOP_K=5

# Confidence & Refusal Threshold (Empirically Calibrated on Golden Set)
CONFIDENCE_THRESHOLD=0.75

# Qdrant Vector DB Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nyaya_legal_corpus
QDRANT_API_KEY=

# Document Paths
PDF_PATH=BNS bare act 2023.pdf
