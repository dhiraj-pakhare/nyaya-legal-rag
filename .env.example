# Embedding Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_DEVICE=cpu

# Cross-Encoder Reranker Configuration
RERANKER_MODEL_NAME=cross-encoder/ms-marco-TinyBERT-L-2-v2
RERANKER_CANDIDATE_K=10
RERANKER_TOP_K=5

# Confidence & Refusal Threshold (Empirically Calibrated on Golden Set)
CONFIDENCE_THRESHOLD=0.75

# Qdrant Vector DB Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nyaya_legal_corpus
QDRANT_API_KEY=

# Document Paths
PDF_PATH=BNS bare act 2023.pdf

# Phase 5: LLM Generation & Citation Safety
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_CHARS=8000
LLM_COST_PER_1K_INPUT_TOKENS=0.0
LLM_COST_PER_1K_OUTPUT_TOKENS=0.0

# Phase 6: User-Document RAG & Multi-Tenant Isolation
QDRANT_USER_COLLECTION=nyaya_user_documents
MAX_USER_DOC_SIZE_BYTES=26214400
OCR_ENABLED=true
OCR_MAX_PAGES=10
OCR_TIMEOUT_SECONDS=10.0
